# konsoleH PostgreSQL — use the hostname from Services → PostgreSQL, never localhost
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"

# Required at runtime. Generate a long random string for production.
JWT_SECRET=""

# Required before `npm run build` so the map key is baked into the client.
NEXT_PUBLIC_TOMTOM_API_KEY=""
