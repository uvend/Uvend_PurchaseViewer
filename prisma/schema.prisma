datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(cuid())
  name         String?
  username     String?      @unique
  email        String?      @unique
  passwordHash String?
  role         UserRole     @default(USER)
  purchases    Purchase[]
  loginEvents  LoginEvent[]
  assignedJobs Job[]
  jobNotes     JobNote[]
  invoices     Invoice[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Purchase {
  id                String   @id @default(cuid())

  userId            String?
  user              User?    @relation(fields: [userId], references: [id])

  shopName          String
  customShop        Boolean  @default(false)

  cardLabel         String
  cardBank          String?
  cardLastFour      String?

  description       String

  ocrText           String?  @db.Text
  ocrRequestId      String?
  ocrWords          Json?
  ocrImageWidth     Int?
  ocrImageHeight    Int?
  ocrImageName      String?
  ocrImageMimeType  String?
  ocrImageBytes     Bytes?

  latitude          Float?
  longitude         Float?
  locationStatus    String?

  slipLabel         String
  slipImageName     String
  slipImageMimeType String
  slipImageBytes    Bytes

  itemLabel         String
  itemImageName     String
  itemImageMimeType String
  itemImageBytes    Bytes

  jobId             String?
  job               Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  invoiceItems      InvoiceItem[]

  purchasedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LoginEvent {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  username  String
  role      UserRole?
  success   Boolean
  source    String
  createdAt DateTime  @default(now())
}

enum UserRole {
  USER
  INSTALLER
  ADMIN
}

enum JobStatus {
  TODO
  ACTIVE
  COMPLETE
}

enum InvoiceItemKind {
  LABOUR
  MATERIALS
  TOOLS
}

model Job {
  id             String     @id @default(cuid())
  title          String
  customerName   String
  customerPhone  String?
  customerEmail  String?
  address        String
  status         JobStatus  @default(TODO)
  assignedUserId String?
  assignedUser   User?      @relation(fields: [assignedUserId], references: [id])
  notes          JobNote[]
  invoices       Invoice[]
  purchases      Purchase[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model JobNote {
  id             String   @id @default(cuid())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  text           String
  source         String
  latitude       Float?
  longitude      Float?
  locationStatus String?
  createdAt      DateTime @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  jobId       String
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  number      String        @unique
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseId  String?         @unique
  purchase    Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  kind        InvoiceItemKind
  description String
  amount      Float
  createdAt   DateTime        @default(now())
}